<!DOCTYPE html>
<html lang="ru">
<head><meta charset="UTF-8"><title><%= title %></title><style>body{font-family:Arial;max-width:760px;margin:35px auto;padding:0 18px;color:#18332d}footer{border-top:1px solid #ddd;margin-top:25px;padding-top:12px}</style></head>
<body>
  <%- include("partials/menu.ejs") %>
  <h1><%= title %></h1>
  <% if (emailsVisible) { %>
    <h2>Электронные адреса</h2>
    <ul>
      <% emails.forEach(function(email) { %>
        <li><%= email %></li>
      <% }); %>
    </ul>
  <% } else { %>
    <p>Электронные адреса не отображаются.</p>
  <% } %>
  <p>Телефон: <%= phone %></p>
  <%- include("partials/footer.ejs") %>
</body>
</html>

