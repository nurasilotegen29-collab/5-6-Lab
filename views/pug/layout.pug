doctype html
html(lang="ru")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title= title
    style.
      body { font-family: Arial, sans-serif; max-width: 760px; margin: 35px auto; padding: 0 18px; color: #18332d; line-height: 1.6; }
      main { border: 1px solid #dce8e1; border-radius: 12px; padding: 20px; background: #fff; }
      footer { border-top: 1px solid #ddd; margin-top: 25px; padding-top: 12px; color: #62736d; }
  body
    main
      block content
    include footer.pug

